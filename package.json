{
  "name": "timevault-qa",
  "version": "1.0.0",
  "description": "QA automation framework for the TimeVault e-commerce application",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "SMOKE=1 playwright test --grep @smoke",
    "test:regression": "playwright test",
    "test:e2e": "playwright test --grep @e2e",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:api:clean": "playwright test --project=api --grep-invert @known-bug",
    "test:known-bugs": "playwright test --project=api --grep @known-bug --reporter=list",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "allure:clean": "rm -rf allure-results allure-report"
  },
  "keywords": [
    "qa",
    "playwright",
    "typescript",
    "automation",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure": "^3.33.0",
    "allure-js-commons": "^3.15.0",
    "allure-playwright": "^3.15.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "dotenv": "^18.0.6"
  }
}
